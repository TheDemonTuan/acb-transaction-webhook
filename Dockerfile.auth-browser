# syntax=docker/dockerfile:1.7
FROM golang:1.27.1-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/auth-browser ./cmd/auth-browser
COPY internal/authbrowser ./internal/authbrowser
COPY internal/config ./internal/config
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /auth-browser ./cmd/auth-browser

FROM alpine:3.23
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates chromium novnc openbox tini websockify x11vnc xvfb \
    && adduser -S -u 1000 -h /home/gateway gateway
COPY --from=build /auth-browser /auth-browser
COPY cmd/auth-browser/entrypoint.sh /entrypoint.sh
RUN chmod 0755 /auth-browser /entrypoint.sh
USER 1000:1000
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=3 CMD ["/auth-browser", "--healthcheck"]
ENTRYPOINT ["/sbin/tini", "--", "/entrypoint.sh"]
