# Security policies migrated verbatim from Traefik; do not broaden them here.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com; script-src-elem 'self' https://static.cloudflareinsights.com 'unsafe-inline'; script-src-attr 'none'; connect-src 'self' ws: wss: https://cloudflareinsights.com; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'

/__release
  Cache-Control: no-store
  Content-Type: text/plain; charset=utf-8

# Capability pages must never be cached or leaked through navigation referrers.
/pay
  Cache-Control: no-store
  ! Referrer-Policy
  Referrer-Policy: no-referrer

/pay/*
  Cache-Control: no-store
  ! Referrer-Policy
  Referrer-Policy: no-referrer
