{
  "name": "acb-transaction-webhook-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun run --bun vite --host 127.0.0.1",
    "typecheck": "bun check",
    "build": "bun run typecheck && bun scripts/build.ts",
    "build:cloudflare": "bun run build && bun scripts/prepare-cloudflare.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "e2e": "bun ./node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "jsqr": "1.4.0",
    "lucide-react": "1.44.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "@types/bun": "1.4.3",
    "postcss": "8.5.30",
    "vite": "8.3.0",
    "wrangler": "4.147.0"
  }
}
