[Unit]
Description=VPS Multi-App Unified Failover Controller (Event-Driven & Reconcile Engine)
After=docker.service
Requires=docker.service
Documentation=https://github.com/tuannguyenviet/tuan-acb-email-webhook

[Service]
Type=simple
# Security Notice: Process access to Docker daemon confers root-equivalent host privileges.
# Host filesystem exposure is minimized via strict systemd sandboxing and root-owned trusted config.
User=root
Group=root
WorkingDirectory=/opt/platform/failover
Environment=ACB_TX_JOURNAL_FILE=/opt/acb-transaction-webhook/data/deploy-journal.json
ExecStart=/usr/bin/python3 /opt/platform/failover/vps-failover-controller.py
Restart=always
RestartSec=5s

# Filesystem Sandboxing & Hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

# Strict path boundary permissions
ReadWritePaths=/var/lib/vps-failover /run/lock/vps-failover
ReadOnlyPaths=/etc/vps-failover /opt/platform/failover

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
