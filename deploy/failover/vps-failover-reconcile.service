[Unit]
Description=VPS Failover Reconciliation Safety Net Scan
After=docker.service
Documentation=https://github.com/tuannguyenviet/tuan-acb-email-webhook

[Service]
Type=oneshot
# Security Notice: Process access to Docker daemon confers root-equivalent host privileges.
User=root
Group=root
WorkingDirectory=/opt/platform/failover
ExecStart=/usr/bin/python3 /opt/platform/failover/vps-failover-controller.py --reconcile

# Filesystem Sandboxing & Hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

ReadWritePaths=/var/lib/vps-failover /run/lock/vps-failover
ReadOnlyPaths=/etc/vps-failover /opt/platform/failover

StandardOutput=journal
StandardError=journal
