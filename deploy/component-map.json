{
  "version": 1,
  "documentation": [
    "(^|/)README[^/]*\\.md$",
    "\\.md$",
    "^docs/",
    "^LICENSE",
    "^\\.gitignore$",
    "^\\.gitattributes$",
    "^\\.github/dependabot\\.yml$",
    "^\\.dockerignore$",
    "^\\.env\\.example$",
    "\\.txt$"
  ],
  "rules": [
    {"pattern": "^deploy/smoke-public-payment-qr\\.sh$", "components": ["platform"]},
    {"pattern": "^deploy/lib/traefik\\.sh$", "components": ["platform"]},
    {"pattern": "^deploy/(dispatch-rollout\\.sh|stable-deployer\\.sh|preflight-vps\\.sh|preflight-runtime\\.sh|stage-immutable-release\\.sh|verify-release-baseline\\.sh|verify-staged-release\\.sh|runtime-layout\\.sh|reconcile-release\\.sh|release-state\\.py|rollback-release\\.sh|bootstrap-deployment-engine\\.sh|generate-release-manifest\\.sh|verify-manifest\\.sh|verify-runtime-drift\\.sh|release-env\\.sh|edge-probe\\.sh|lib(\\.sh|/.*)|component-map\\.json)$|^scripts/(compute-promotion-scope|test-promotion-scope)\\.sh$", "components": ["orchestrator"]},
    {"pattern": "^cmd/dbtool/|^Dockerfile\\.dbtool$|^internal/storage/migrations/|^deploy/deploy-schema\\.sh$|^deploy/compose/dbtool\\.yaml$", "components": ["schema", "gateway", "worker"]},
    {"pattern": "^web/|^deploy/frontend-nginx\\.conf$|^deploy/deploy-frontend\\.sh$|^deploy/compose/frontend\\.yaml$", "components": ["frontend"]},
    {"pattern": "^cmd/gateway/|^internal/httpapi/|^internal/csrf/|^deploy/deploy-gateway\\.sh$|^deploy/compose/gateway\\.yaml$", "components": ["gateway"]},
    {"pattern": "^cmd/worker/|^internal/workerstate/|^internal/maintenance/|^internal/upstream/|^deploy/deploy-worker\\.sh$|^deploy/compose/worker\\.yaml$", "components": ["worker"]},
    {"pattern": "^cmd/egress-proxy/", "components": ["worker", "gateway"]},
    {"pattern": "^tests/integration/", "components": ["gateway", "worker", "schema"]},
    {"pattern": "^cmd/auth-browser/|^Dockerfile\\.auth-browser$|^internal/authbrowser/|^deploy/(seccomp-auth-browser\\.json|smoke-test-auth-browser\\.sh|deploy-auth-browser\\.sh|compose/auth-browser\\.yaml)$", "components": ["auth_browser"]},
    {"pattern": "^internal/", "components": ["gateway", "worker"]},
    {"pattern": "^(go\\.mod|go\\.sum)$", "components": ["gateway", "worker", "schema"]},
    {"pattern": "^tts-gateway/|^deploy/(smoke-test-tts-gateway\\.sh|deploy-tts\\.sh|compose/tts\\.yaml)$", "components": ["tts"]},
    {"pattern": "^deploy/(third-party-allowlist\\.json|verify-third-party-policy\\.sh|smoke-test-bark\\.sh|bark-entrypoint\\.sh|deploy-bark\\.sh|compose/bark\\.yaml)$", "components": ["bark"]},
    {"pattern": "^platform/failover/|^deploy/failover/|^deploy/(deploy-failover-controller|stage-platform-assets)\\.sh$", "components": ["failover_controller"]},
    {"pattern": "^deploy/compose/base\\.yaml$", "components": ["frontend", "gateway", "worker", "schema", "auth_browser", "tts", "bark", "failover_controller", "platform"]},
    {"pattern": "^Dockerfile$|^deploy/compose\\.prod\\.yaml$", "components": ["frontend", "gateway", "worker", "schema", "auth_browser", "tts", "bark", "platform"]},
    {"pattern": "^\\.github/workflows/(deploy|ci|codacy)\\.yml$|^scripts/|^deploy/tests/|^platform/edge/|^deploy/edge/|^compose\\.yaml$|^deploy/(backup.*|restore.*|provision.*|check-host|init-fresh-data|deploy-warm|rollback-warm|switch-slot|smoke-slot|deploy-platform|deploy|rollback|verify-deployment|verify-compose-runtime|validate-cve-allowlist|cve-allowlist|preflight-scan-images|release-env|render-traefik-route|test-supply-chain)\\.(sh|json)$", "components": ["platform"]}
  ],
  "unknown": []
}
