{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchPrefix": "rcc/",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:gomodIndirectSecurityUpdates"
  ],
  "enabledManagers": [
    "bun",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gomod",
    "pip-compile",
    "custom.regex"
  ],
  "timezone": "Asia/Ho_Chi_Minh",
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "respectLatest": true,
  "ignoreUnstable": true,
  "separateMinorPatch": true,
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "vulnerabilityFixStrategy": "lowest",
    "minimumReleaseAge": null,
    "schedule": []
  },
  "postUpdateOptions": ["gomodTidy"],
  "pip-compile": {
    "managerFilePatterns": ["/^tts-gateway/requirements(?:-dev)?\\.lock$/"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["before 6am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^web/\\.bun-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "bun",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["TRIVY_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["--package renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Track immutable Docker digests, including non-versioned base tags.",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Bypass release-age delay for Dockerfile patch and digest security rebuilds.",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch", "digest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Bypass release-age delay for Go, Python, and Node runtime patch releases.",
      "matchPackageNames": ["go", "actions/go-versions", "actions/python-versions", "actions/node-versions"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": null
    },
    {
      "description": "Update the Bun toolchain promptly without raising minimum compatibility.",
      "matchPackageNames": ["bun", "@types/bun"],
      "groupName": "Bun toolchain",
      "minimumReleaseAge": null,
      "rangeStrategy": "bump"
    },
    {
      "description": "Minimum Bun compatibility is a deliberate application decision.",
      "matchManagers": ["bun", "npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["bun"],
      "enabled": false
    }
  ]
}
