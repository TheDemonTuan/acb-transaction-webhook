{
  "app": "acb",
  "workload_class": "blue_green",
  "cooldown_seconds": 300,
  "max_restarts": 3,
  "health_timeout": 20,
  "switch_cmd": ["/usr/local/bin/platform-switch", "{app}", "{slot}"],
  "slots": {
    "blue": {
      "container_name": "acb-gateway-blue",
      "service": "gateway-blue"
    },
    "green": {
      "container_name": "acb-gateway-green",
      "service": "gateway-green"
    }
  }
}
